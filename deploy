#!/bin/bash
set -e
cd "$(dirname "$0")"

# 1. Ensure the project exists (Run this once, or use --skip-confirmation)
# You only need this command once. After it is created, you can comment this line out.
npx wrangler pages project create claude-test --production-branch main || true

# 2. Stamp the exact commit being deployed into the commit badge
# (git-connected build: HEAD is the commit that triggered this build).
# If HEAD is unavailable the placeholder stays and the badge simply hides.
if COMMIT_SHA=$(git rev-parse HEAD 2>/dev/null); then
  sed -i "s/__COMMIT_SHA__/${COMMIT_SHA}/g" web/index.html
fi

# 3. Deploy your project
npx wrangler pages deploy web/ --project-name claude-test
